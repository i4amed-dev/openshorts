# ============================================================================
# AUTOPILOT — unattended content engine (self-hosted)
# ============================================================================
# Autopilot runs with no browser open, so it cannot read the API keys the
# dashboard keeps in localStorage. Every credential it needs must be set here.
# None of these are ever returned by the API, written to the Autopilot database
# or printed to a log — /api/autopilot/status reports only whether each is set.

# Required. The clip pipeline's model key. Already used by manual mode as the
# self-host fallback when no X-Gemini-Key header is sent.
# GEMINI_API_KEY=

# Required for Autopilot. YouTube Data API v3 key for discovery.
#   console.cloud.google.com → new project → APIs & Services →
#   Enable "YouTube Data API v3" → Credentials → Create API key.
# Restrict it to the YouTube Data API. Two independent daily allocations:
#   general  ~10,000 units — videos.list (1 unit), used by trending discovery
#   search   ~100 calls    — search.list (1 unit), used by niche topic search
# Exhausting one does not stop the other.
# YOUTUBE_DATA_API_KEY=

# Required for Autopilot publishing. Same Upload-Post key manual mode uses.
# UPLOAD_POST_API_KEY=

# WHICH Upload-Post profile Autopilot posts as. Precedence:
#   1. Autopilot's own setting (`publishing.upload_post_user`), chosen from the
#      profile picker in Autopilot setup — this is the normal path.
#   2. This variable, as a fallback for a config that predates the picker.
# A profile username is not a secret, so it may live in the Autopilot database;
# the API key never does and is read from the environment only.
# UPLOAD_POST_USER=

# Turn the whole subsystem off (routes + scheduler loop). Defaults to on for
# self-host, off when BILLING_ENABLED is set. Manual mode is unaffected either way.
# AUTOPILOT_ENABLED=1

# Where Autopilot's SQLite state lives. MUST be on a persistent volume —
# docker-compose.yml mounts the `autopilot-state` named volume here. Losing this
# file means losing which sources were processed and which posts were already
# sent, i.e. duplicate processing and duplicate publishing after an update.
# AUTOPILOT_DB_PATH=/app/output/autopilot/autopilot.db

# Orchestrator loop interval, and how long a scheduler lease is held. The lease
# stops two processes driving the state machine; it expires so a crashed holder
# cannot wedge the system. Defaults are fine.
# AUTOPILOT_TICK_SECONDS=30
# AUTOPILOT_LEASE_TTL=120

# Heavy pipeline concurrency. Keep this at 1 on a laptop: Whisper + YOLO/
# MediaPipe + FFmpeg will use every core, and a second concurrent job makes the
# machine unresponsive rather than faster. Autopilot additionally enforces one
# active pipeline of its own regardless of this value.
# MAX_CONCURRENT_JOBS=1

# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264
