# Klippo — cloud/billing mode on a single host.
#   cp .env.prod.example .env.prod   (then fill it in; never commit .env.prod)
#
# Every name here is read by the code — see cloud/config.py. Anything you leave
# out either disables its feature or fails the deploy loudly, as noted.

# ── Required: the deploy will not start without these ────────────────────────
POSTGRES_PASSWORD=            # compose fails loudly if unset
JWT_SECRET=                   # session signing. openssl rand -hex 32
ACME_EMAIL=                   # Let's Encrypt expiry notices (Caddyfile)

# ── Public URLs. Must match your DNS and the Google OAuth console exactly ────
FRONTEND_URL=https://klippo.one
ALLOWED_ORIGINS=https://klippo.one
VITE_API_URL=https://api.klippo.one
OAUTH_REDIRECT_URI=https://api.klippo.one/api/auth/google/callback

# ── Sign-in (Google OAuth) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Billing. Prices resolve by lookup_key at runtime, so no price IDs here.
# Create products in Stripe with these lookup_keys before going live:
#   starter_monthly  starter_yearly
#   creator_monthly  creator_yearly
#   pro_monthly      pro_yearly
#   topup_60         topup_200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # from the endpoint you point at api.klippo.one

# ── Managed provider keys (this is what paying users are buying) ─────────────
MANAGED_GEMINI_API_KEY=
MANAGED_UPLOAD_POST_API_KEY=  # optional: server-side social posting

# ── Email: magic-link sign-in and admin alerts. Without SMTP, login breaks. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Klippo <no-reply@klippo.one>
ADMIN_EMAIL=                  # where failure alerts go

# ── Durable clip storage (Cloudflare R2). Without it, clips live only on this
# server's disk and are lost if you rebuild the host.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2         # each job is ffmpeg + whisper; 5 will thrash 8 vCPU
WHISPER_MODEL=small           # base is faster, small is better on non-English
OUTPUT_MAX_GB=50              # janitor ceiling for output/
UPLOADS_MAX_GB=20
KLIPPO_LOGO_URL=https://klippo.one/brand/logo.png

# ── Optional ─────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=         # ops alerts to Telegram instead of / as well as email
# TELEGRAM_CHAT_ID=
# PROXY_URL=                  # HTTP proxy for YouTube downloads
# YOUTUBE_COOKIES=            # Netscape-format cookies to bypass bot detection
# WATERMARK=1                 # watermark free-plan clips
